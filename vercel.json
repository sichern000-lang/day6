{
  "regions": [
    "icn1"
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/agent.js": {
      "maxDuration": 60,
      "includeFiles": "src/{data,lib}/**"
    },
    "api/translate.js": {
      "maxDuration": 30,
      "includeFiles": "src/lib/**"
    },
    "api/catalog.js": {
      "maxDuration": 30,
      "includeFiles": "src/data/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
