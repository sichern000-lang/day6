# 복사해서 .env.local 로 이름 바꾼 뒤 값을 채우세요 (.env.local 은 git 에 올라가지 않습니다)
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 → 공개돼도 되는 값만!
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요 ──
# 공공데이터포털(data.go.kr) 일반 인증키는 "Decoding" 키를 넣습니다
DATA_GO_KR_KEY=            # 기상청 단기예보 · 한국관광공사 국문 관광정보
TOUR_ENG_KEY=              # 한국관광공사 영문 관광정보 (비워 두면 DATA_GO_KR_KEY 를 대신 사용)
# 영문 관광정보 End Point — 포털 활용신청 상세의 End Point 와 다르면 여기서 바꾸세요
TOUR_ENG_BASE=https://apis.data.go.kr/B551011/EngService2
GEMINI_API_KEY=            # Google AI Studio 에서 발급 — 안내자(에이전트)·영어 번역
GEMINI_MODEL=gemini-flash-lite-latest       # 안내자(Ask)용 — 시연에서는 빠른 것보다 끝까지 동작하는 모델이 중요
GEMINI_FAST_MODEL=gemini-flash-lite-latest  # 번역·요약 등 짧은 호출용
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite   # 위 모델이 바쁘면(503·429) 순서대로 자동 재시도 (기본값)

# 제주도청 설화·신화·민담 API 는 인증키가 필요 없습니다
